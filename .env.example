# Copiar a .env y llenar. El .env real NO se versiona.

# --- MariaDB ---
MARIADB_ROOT_PASSWORD=
DB_NAME=matriz
DB_USER=matriz
DB_PASSWORD=

# --- JWT ---
# Generar con: openssl rand -hex 32
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- URLs ---
# Sin barra final. Se incrusta en el bundle al construir el frontend.
PUBLIC_URL=
FRONTEND_URL=
ALLOWED_ORIGINS=

# --- UAFE ---
UAFE_API_KEY=

# --- Cloudflare Tunnel ---
CLOUDFLARE_TUNNEL_TOKEN=
